APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# For local development without Docker, keep SQLite by default.
DATABASE_URL=sqlite:///./mnemora.db

# For Docker Compose / PostgreSQL target environment, use this value instead:
# DATABASE_URL=postgresql+psycopg://mnemora:change-me@postgres:5432/mnemora
POSTGRES_DB=mnemora
POSTGRES_USER=mnemora
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o-mini
